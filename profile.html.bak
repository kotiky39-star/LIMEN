<!DOCTYPE html>
<html lang="en">
<head>
<meta charset="UTF-8">
<meta name="viewport" content="width=device-width, initial-scale=1.0">
<title>NEXUS — Profile</title>
<link rel="stylesheet" href="fonts/fonts.css">
<script src="https://cdn.tailwindcss.com"></script>
<script>
  tailwind.config = { theme: { extend: {
    fontFamily: { sans:['Inter','system-ui','sans-serif'], cinzel:['Cinzel','Cormorant Garamond','Georgia','serif'] },
    colors: { nexus:'#38bdf8' }
  } } }
</script>
<script src="https://cdnjs.cloudflare.com/ajax/libs/gsap/3.12.5/gsap.min.js"></script>
<script src="https://cdnjs.cloudflare.com/ajax/libs/gsap/3.12.5/ScrollTrigger.min.js"></script>
<script src="https://cdn.jsdelivr.net/npm/lenis@1.1.13/dist/lenis.min.js"></script>
<style>
  :root { --noise: url("data:image/svg+xml;utf8,<svg xmlns='http://www.w3.org/2000/svg' width='200' height='200'><filter id='n'><feTurbulence type='fractalNoise' baseFrequency='.9' numOctaves='2' stitchTiles='stitch'/></filter><rect width='100%' height='100%' filter='url(%23n)' opacity='.5'/></svg>"); }
  html,body { background:#030712; }
  body { font-family:'Inter',system-ui,sans-serif; color:#e2e8f0; overflow-x:hidden; }
  .grain { position:fixed; inset:-50%; z-index:60; pointer-events:none; opacity:.05; background-image:var(--noise); animation:grain 1.2s steps(6) infinite; }
  @keyframes grain { 0%,100%{transform:translate(0,0)} 20%{transform:translate(-3%,2%)} 40%{transform:translate(2%,-3%)} 60%{transform:translate(-2%,-1%)} 80%{transform:translate(3%,3%)} }
  .glass { background:rgba(255,255,255,.06); backdrop-filter:blur(14px); -webkit-backdrop-filter:blur(14px); border:1px solid rgba(255,255,255,.12); }
  .nav-link { position:relative; opacity:.65; transition:opacity .3s; }
  .nav-link:hover,.nav-link.is-active { opacity:1; }
  .nav-link::after { content:''; position:absolute; left:0; bottom:-4px; height:1px; width:100%; background:#38bdf8; transform:scaleX(0); transform-origin:right; transition:transform .5s cubic-bezier(.2,.8,.2,1); }
  .nav-link:hover::after,.nav-link.is-active::after { transform:scaleX(1); transform-origin:left; }
  .badge { transition:transform .3s, box-shadow .3s; }
  .badge:hover { transform:translateY(-4px) scale(1.03); box-shadow:0 0 28px rgba(56,189,248,.35); }
@media (max-width:768px) {
  header .glass { flex-direction:column; align-items:stretch; gap:.75rem; }
  nav { justify-content:center; flex-wrap:wrap; }
  .search-wrap { max-width:100%; }
}

.modal { position:fixed; inset:0; z-index:80; display:none; align-items:center; justify-content:center; background:rgba(0,0,0,.7); backdrop-filter:blur(12px); -webkit-backdrop-filter:blur(12px); }
.modal-card { max-width:720px; width:92%; max-height:85vh; overflow:auto; position:relative; }
.tab-btn { opacity:.6; border-bottom:2px solid transparent; padding:.5rem 0; transition:opacity .3s,border-color .3s; }
.tab-btn.is-active { opacity:1; border-color:#38bdf8; color:#38bdf8; }

.badge.locked { filter:grayscale(100%); opacity:.45; }
.badge.unlocked { border:1px solid #38bdf8; box-shadow:0 0 18px rgba(56,189,248,.35); }
.collection-cover { position:relative; aspect-ratio:4/3; border-radius:12px; overflow:hidden; cursor:pointer; }
.collection-cover img { width:100%; height:100%; object-fit:cover; }
.collection-cover-overlay { position:absolute; inset:0; background:linear-gradient(180deg,transparent 0%,rgba(0,0,0,.7) 100%); display:flex; flex-direction:column; justify-content:flex-end; padding:1rem; }
.collection-cover-title { font-family:'Cinzel',serif; font-size:1.1rem; color:#fff; margin:0; }
.collection-cover-game { font-size:0.75rem; color:rgba(226,232,240,.6); text-transform:uppercase; letter-spacing:.1em; margin-top:2px; }

/* Cinematic Nexus visual system */
:root{--accent:#38bdf8}
body{background:radial-gradient(circle at 50% 0%,#151525 0%,#050505 100%);color:#e0e0e0;font-family:Inter,system-ui,sans-serif;isolation:isolate}
body::before{content:'';position:fixed;inset:0;pointer-events:none;z-index:-1;opacity:.35;background-image:radial-gradient(1px 1px at 20px 30px,#fff 98%,transparent),radial-gradient(1px 1px at 95px 115px,#8ccfff 98%,transparent);background-size:173px 191px,277px 263px}
h1,h2,h3,.font-cinzel{font-family:Cinzel,Georgia,serif;text-shadow:0 0 10px #ffffff33}
.glass,.modal-card,.collection-cover{background:rgba(15,15,20,.7);backdrop-filter:blur(16px);-webkit-backdrop-filter:blur(16px);border:1px solid #ffffff1a;border-radius:12px}
.modal{background:#000b;backdrop-filter:blur(16px);padding:16px}.modal-nested{background:#000d}
.modal-card{box-shadow:0 24px 100px #0009}
.card{transition:border-color .3s,box-shadow .3s,scale .3s}.card:hover{scale:1.02;border-color:var(--accent);box-shadow:0 0 28px #38bdf826}
header>.glass{box-shadow:0 12px 40px #0006}
input,textarea,select{color:#e0e0e0;background:#090c14!important;transition:border-color .25s,box-shadow .25s}input:focus,textarea:focus,select:focus{outline:none;border-color:var(--accent);box-shadow:0 0 14px #38bdf82b}option{background:#090c14}
img{background:#10131b}button:focus-visible,a:focus-visible{outline:2px solid var(--accent);outline-offset:4px}
@media(max-width:768px){header>.glass{gap:10px;padding:12px 16px}header nav{display:flex;font-size:10px;gap:16px}.search-wrap{width:100%}main{padding-top:240px!important;padding-bottom:100px}}
@media(prefers-reduced-motion:reduce){*,*::before,*::after{animation:none!important;transition:none!important}}

#xp-fill{background:linear-gradient(90deg,#00ffff,#0066ff);box-shadow:0 0 10px #00ffff;border-radius:999px;transition:width .8s}
.badge.locked{filter:grayscale(100%) opacity(.5);opacity:1}.badge.unlocked{border-color:#d4af6a;box-shadow:0 0 20px #00ffff26,inset 0 0 24px #d4af6a08}
.collection-cover{aspect-ratio:3/4;min-height:280px}.collection-cover img{position:absolute;inset:0;transition:transform .6s}.collection-cover:hover img{transform:scale(1.05)}.collection-cover-overlay{background:linear-gradient(180deg,transparent 25%,#030712f5);padding:24px 18px}
#btn-open-auth{width:auto;min-width:36px;padding-inline:12px;font-size:11px}

.modal-card{font-size:1rem;line-height:1.6}
.card:hover{box-shadow:0 0 28px color-mix(in srgb,var(--accent) 20%,transparent)}
</style>
<script src="data.js"></script>
</head>
<body class="min-h-screen">
<div class="grain"></div>
<div id="page-transition" class="fixed inset-0 bg-black z-[100] opacity-0 pointer-events-none"></div>
<header class="fixed top-0 left-0 right-0 z-50">
  <div class="glass mx-4 mt-4 rounded-2xl px-5 py-3 flex items-center gap-4">
    <a href="index.html" class="font-cinzel tracking-[.35em] text-lg text-white">NEXUS</a>
    <nav class="hidden md:flex gap-6 text-xs uppercase tracking-[.25em]">
      <a href="index.html" class="nav-link">Home</a>
      <a href="lore.html" class="nav-link">Lore</a>
      <a href="profile.html" class="nav-link is-active">Profile</a>
    </nav>
    <div class="search-wrap relative flex-1 max-w-md mx-auto">
      <input id="nexus-search" type="text" placeholder="Search the nexus..." class="w-full bg-white/5 border border-white/10 rounded-full px-4 py-2 text-sm outline-none focus:border-nexus/60">
      <div id="search-results" class="absolute top-full mt-2 w-full glass rounded-xl overflow-hidden hidden z-50"></div>
    </div>
    <button id="btn-open-auth" class="w-9 h-9 rounded-full bg-gradient-to-br from-nexus to-indigo-600 grid place-items-center text-sm font-semibold">Account</button>
  </div>
</header>

<main class="relative pt-28 px-6 max-w-6xl mx-auto grid md:grid-cols-[260px_1fr] gap-8">
  <aside class="glass rounded-2xl p-6 h-fit">
    <div id="sidebar-avatar" class="w-20 h-20 rounded-full bg-gradient-to-br from-nexus to-indigo-600 grid place-items-center text-2xl font-semibold mx-auto">A</div>
    <h2 id="sidebar-name" class="font-cinzel text-xl text-center mt-4">Archivist</h2>
    <p id="sidebar-email" class="text-center text-white/50 text-xs mt-1"></p>
    <p class="text-center text-white/50 text-xs uppercase tracking-[.25em] mt-1">Level 12</p>
    <div class="mt-4 h-2 bg-white/10 rounded-full overflow-hidden"><div id="xp-fill" class="h-full bg-nexus" style="width:0%"></div></div>
    <p id="xp-text" class="text-center text-white/40 text-xs mt-2">0 / 3200 XP</p>
    <div class="mt-6 space-y-2 text-sm text-white/60">
      <div class="flex justify-between"><span>Posts</span><span>47</span></div>
      <div class="flex justify-between"><span>Theories</span><span>12</span></div>
      <div class="flex justify-between"><span>Worlds</span><span>5</span></div>
    </div>
  </aside>

  <section>
    <div class="flex gap-4 border-b border-white/10 mb-6">
      <button class="tab-btn is-active" data-tab="overview">Overview</button>
      <button class="tab-btn" data-tab="achievements">Achievements</button>
      <button class="tab-btn" data-tab="settings">Settings</button>
      <button class="tab-btn" data-tab="collections">Collections</button>
    </div>
    <div id="tab-overview" class="tab-panel space-y-4">
      <div class="glass rounded-2xl p-6"><h3 class="font-cinzel text-xl mb-2">Overview</h3><p class="text-white/60 text-sm">Welcome back, Archivist. You have explored 5 worlds and published 12 theories.</p></div>
    </div>
    <div id="tab-achievements" class="tab-panel hidden">
      <div class="grid sm:grid-cols-2 lg:grid-cols-3 gap-5">
        <div class="glass rounded-2xl p-5 badge card" data-game="rdr2"><div class="text-3xl mb-2">🔫</div><h3 class="font-cinzel text-lg">The Gunslinger</h3><p class="text-white/50 text-sm">Mastered the frontier.</p></div>
        <div class="glass rounded-2xl p-5 badge card" data-game="cyberpunk"><div class="text-3xl mb-2">💻</div><h3 class="font-cinzel text-lg">Netrunner</h3><p class="text-white/50 text-sm">Breached the blackwall.</p></div>
        <div class="glass rounded-2xl p-5 badge card" data-game="ac"><div class="text-3xl mb-2">📜</div><h3 class="font-cinzel text-lg">Lore Master</h3><p class="text-white/50 text-sm">Decoded 100 entries.</p></div>
        <div class="glass rounded-2xl p-5 badge card" data-game="eldenring"><div class="text-3xl mb-2">⚔️</div><h3 class="font-cinzel text-lg">Elden Lord</h3><p class="text-white/50 text-sm">Claimed the throne.</p></div>
        <div class="glass rounded-2xl p-5 badge card" data-game="witcher3"><div class="text-3xl mb-2">🗡️</div><h3 class="font-cinzel text-lg">Witcher</h3><p class="text-white/50 text-sm">Walked the Path.</p></div>
      </div>
    </div>
    <div id="tab-settings" class="tab-panel hidden">
      <form id="settings-form" class="glass rounded-2xl p-6 space-y-4 max-w-lg">
        <input id="username-input" class="w-full bg-white/5 border border-white/10 rounded-lg px-4 py-2" placeholder="Username">
        <select id="avatar-color" class="w-full bg-white/5 border border-white/10 rounded-lg px-4 py-2">
          <option value="from-nexus to-indigo-600">Blue</option>
          <option value="from-red-500 to-orange-500">Red</option>
          <option value="from-emerald-500 to-teal-500">Green</option>
        </select>
        <button type="submit" class="glass rounded-full px-6 py-2">Save</button>
      </form>
    </div>
  <div id="tab-collections" class="tab-panel hidden">
    <button id="create-collection-btn" class="glass rounded-full px-5 py-2 mb-6">+ Create Collection</button>
    <div id="collections-grid" class="grid sm:grid-cols-2 lg:grid-cols-3 gap-5"></div>
  </div>
  </section>

<div id="collection-modal" class="modal">
  <div class="modal-card glass rounded-2xl p-6">
    <form id="collection-form" class="space-y-4">
      <input id="collection-title" class="w-full bg-white/5 border border-white/10 rounded-lg px-4 py-2" placeholder="Collection title" required>
      <input id="collection-cover" class="w-full bg-white/5 border border-white/10 rounded-lg px-4 py-2" placeholder="Cover Image URL (optional)">
      <select id="collection-game" class="w-full bg-white/5 border border-white/10 rounded-lg px-4 py-2"></select>
      <button type="submit" class="glass rounded-full px-6 py-2">Create</button>
    </form>
  </div>
</div>
</main>

<script>
  const lenis = new Lenis({duration:1.1});
  function raf(t){ lenis.raf(t); requestAnimationFrame(raf); }
  requestAnimationFrame(raf);
  const COLLECTIONS_KEY = 'nexusCollections';
  function renderCollections() {
    const grid = document.getElementById('collections-grid');
    grid.innerHTML = '';
    JSON.parse(localStorage.getItem(COLLECTIONS_KEY) || '[]').forEach(c => {
      const card = document.createElement('div');
      card.className = 'collection-cover card';
      const coverUrl = c.cover || 'https://images.unsplash.com/photo-1444385747925-d75a1f950578?q=80&w=800&auto=format&fit=crop';
      card.innerHTML = `
        <img src="${nexusImage(coverUrl)}" alt="${c.title}">
        <div class="collection-cover-overlay">
          <p class="collection-cover-title">${c.title}</p>
          <p class="collection-cover-game">${(GAMES[c.game] || {}).title || c.game}</p>
        </div>
      `;
      grid.appendChild(card);
    });
  }
  const collectionSelect = document.getElementById('collection-game');
  Object.values(GAMES).forEach(g => {
    const o = document.createElement('option');
    o.value = g.id; o.textContent = g.title;
    collectionSelect.appendChild(o);
  });
  document.getElementById('create-collection-btn').addEventListener('click', () => openModal(document.getElementById('collection-modal')));
  document.getElementById('collection-form').addEventListener('submit', e => {
    e.preventDefault();
    const list = JSON.parse(localStorage.getItem(COLLECTIONS_KEY) || '[]');
    list.push({ title: document.getElementById('collection-title').value.trim(), game: document.getElementById('collection-game').value, cover: document.getElementById('collection-cover').value.trim() });
    localStorage.setItem(COLLECTIONS_KEY, JSON.stringify(list));
    renderCollections();
    e.target.reset();
    closeModal(document.getElementById('collection-modal'));
  });
  renderCollections();
  function refreshGamification() {
    const read = JSON.parse(localStorage.getItem('readArticles') || '[]');
    const counts = read.reduce((a, g) => (a[g] = (a[g] || 0) + 1, a), {});
    let unlocked = 0;
    document.querySelectorAll('.badge').forEach(badge => {
      const isUnlocked = (counts[badge.dataset.game] || 0) >= 3;
      badge.classList.toggle('locked', !isUnlocked);
      badge.classList.toggle('unlocked', isUnlocked);
      if (isUnlocked) unlocked++;
    });
    document.getElementById('xp-fill').style.width = (unlocked / 5 * 100) + '%';
    document.getElementById('xp-text').textContent = (1200 + unlocked * 400) + ' / 3200 XP';
  }
  refreshGamification();
  document.querySelectorAll('.tab-btn').forEach(btn => {
    btn.addEventListener('click', () => {
      document.querySelectorAll('.tab-btn').forEach(b => b.classList.remove('is-active'));
      btn.classList.add('is-active');
      document.querySelectorAll('.tab-panel').forEach(p => {
        if (p.id === `tab-${btn.dataset.tab}`) {
          p.classList.remove('hidden');
          gsap.fromTo(p, {opacity:0, y:12}, {opacity:1, y:0, duration:.3});
        } else p.classList.add('hidden');
      });
    });
  });
  document.getElementById('settings-form').addEventListener('submit', e => {
    e.preventDefault();
    const name = document.getElementById('username-input').value.trim();
    const color = document.getElementById('avatar-color').value;
    if (name) document.getElementById('sidebar-name').textContent = name;
    document.getElementById('sidebar-avatar').className = `w-20 h-20 rounded-full bg-gradient-to-br ${color} grid place-items-center text-2xl font-semibold mx-auto`;
  });
</script>

<script>
const pageTransition = document.getElementById('page-transition');
document.querySelectorAll('a[href$=".html"]').forEach(a => {
  a.addEventListener('click', e => {
    e.preventDefault();
    gsap.to(pageTransition, { opacity:1, duration:.35, onComplete: () => { location.href = a.href; } });
  });
});
function openModal(el){
  el.style.display='flex';
  gsap.fromTo(el, {opacity:0}, {opacity:1, duration:.25});
  gsap.fromTo(el.querySelector('.modal-card'), {scale:.92, opacity:0}, {scale:1, opacity:1, duration:.35, ease:'back.out(1.4)'});
}
function closeModal(el){
  gsap.to(el, {opacity:0, duration:.25, onComplete: () => { el.style.display='none'; } });
}
</script>

<div id="auth-modal" class="modal">
  <div class="modal-card glass rounded-2xl p-6">
    <button id="auth-close" class="absolute top-4 right-4 text-white/60 hover:text-white">✕</button>
    <h3 class="font-cinzel text-xl mb-4">Sign In / Register</h3>
    <input id="auth-email" type="email" placeholder="Email" class="w-full bg-white/5 border border-white/10 rounded-lg px-4 py-2 mb-3">
    <input id="auth-password" type="password" placeholder="Password" class="w-full bg-white/5 border border-white/10 rounded-lg px-4 py-2 mb-4">
    <div class="flex gap-3">
      <button id="btn-login" class="flex-1 glass rounded-full px-6 py-2">Login</button>
      <button id="btn-register" class="flex-1 glass rounded-full px-6 py-2">Register</button>
    </div>
    <p id="auth-msg" class="mt-3 text-sm text-red-400 hidden"></p>
  </div>
</div>

<script>
const API_BASE = 'http://localhost:8000';
const btnOpenAuth = document.getElementById('btn-open-auth');
const authModal = document.getElementById('auth-modal');
const btnLogin = document.getElementById('btn-login');
const btnRegister = document.getElementById('btn-register');
const authClose = document.getElementById('auth-close');
const authMsg = document.getElementById('auth-msg');
const authEmail = document.getElementById('auth-email');
const authPassword = document.getElementById('auth-password');
const sidebarName = document.getElementById('sidebar-name');
const sidebarEmail = document.getElementById('sidebar-email');

function showAuthMsg(msg) {
  authMsg.textContent = msg;
  authMsg.classList.remove('hidden');
}
function hideAuthMsg() {
  authMsg.classList.add('hidden');
}

function openAuthModal() {
  hideAuthMsg();
  authEmail.value = '';
  authPassword.value = '';
  openModal(authModal);
}
function closeAuthModal() {
  closeModal(authModal);
}

btnOpenAuth.addEventListener('click', openAuthModal);
authClose.addEventListener('click', closeAuthModal);

async function loadUser() {
  const token = localStorage.getItem('access_token');
  if (!token) return;
  try {
    const res = await fetch(API_BASE + '/api/me', {
      headers: { Authorization: 'Bearer ' + token }
    });
    if (!res.ok) {
      localStorage.removeItem('access_token');
      return;
    }
    const user = await res.json();
    sidebarName.textContent = user.email;
    sidebarEmail.textContent = 'Member since ' + new Date(user.created_at).toLocaleDateString();
    btnOpenAuth.textContent = 'Sign Out';
    btnOpenAuth.onclick = () => {
      localStorage.removeItem('access_token');
      location.reload();
    };
  } catch (e) {
    console.error('loadUser failed', e);
  }
}

async function doRegister() {
  hideAuthMsg();
  const email = authEmail.value.trim();
  const password = authPassword.value;
  if (!email || !password) { showAuthMsg('Enter email and password'); return; }
  try {
    const res = await fetch(API_BASE + '/api/register', {
      method: 'POST',
      headers: { 'Content-Type': 'application/json' },
      body: JSON.stringify({ email, password })
    });
    if (!res.ok) {
      const err = await res.json().catch(() => ({}));
      showAuthMsg(err.detail || 'Register failed');
      return;
    }
    const data = await res.json();
    localStorage.setItem('access_token', data.access_token);
    closeAuthModal();
    await loadUser();
  } catch (e) {
    showAuthMsg('Network error: ' + e.message);
  }
}

async function doLogin() {
  hideAuthMsg();
  const email = authEmail.value.trim();
  const password = authPassword.value;
  if (!email || !password) { showAuthMsg('Enter email and password'); return; }
  try {
    const res = await fetch(API_BASE + '/api/login', {
      method: 'POST',
      headers: { 'Content-Type': 'application/json' },
      body: JSON.stringify({ email, password })
    });
    if (!res.ok) {
      const err = await res.json().catch(() => ({}));
      showAuthMsg(err.detail || 'Login failed');
      return;
    }
    const data = await res.json();
    localStorage.setItem('access_token', data.access_token);
    closeAuthModal();
    await loadUser();
  } catch (e) {
    showAuthMsg('Network error: ' + e.message);
  }
}

btnRegister.addEventListener('click', doRegister);
btnLogin.addEventListener('click', doLogin);

document.addEventListener('DOMContentLoaded', () => {
  loadUser();
});
</script>
</body>
</html>
